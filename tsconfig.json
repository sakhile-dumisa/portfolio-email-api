{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true, 
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": false
  },
  "include": [
    "src/**/*",
    "react-email-starter/emails/**/*"
  ],
  "exclude": [
    "node_modules",
    "react-email-starter/node_modules" 
  ]
}