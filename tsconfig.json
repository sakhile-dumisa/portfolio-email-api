{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react", 
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "noEmit": false
  },
  "include": [
    "src/**/*",
    "react-email-starter/emails/**/*"
  ],
  "exclude": ["node_modules"]
}